# ============================================
# SHOPEZ Frontend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================
# Note: Vite requires env variables to be prefixed with VITE_
# Access in code: import.meta.env.VITE_API_URL
# ============================================

# --- API Base URL ---
# In development, Vite proxy handles /api requests (see vite.config.js)
# In production, set this to your deployed backend URL
VITE_API_URL=http://localhost:5000/api

# --- Razorpay (Public Key Only — safe for frontend) ---
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

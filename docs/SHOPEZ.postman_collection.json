    {
      "name": "Cart",
      "description": "Shopping cart endpoints",
      "item": [
        {
          "name": "Add Item to Cart",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/cart" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Cart has items', () => pm.expect(res.data.cart.items).to.be.an('array').that.is.not.empty);",
                  "pm.test('Total price calculated', () => pm.expect(res.data.cart.totalPrice).to.be.above(0));",
                  "",
                  "if (res.success && res.data.cart.items.length > 0) {",
                  "  pm.collectionVariables.set('cartItemId', res.data.cart.items[0]._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/cart" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Cart data returned', () => pm.expect(res.data.cart).to.have.property('items'));",
                  "pm.test('Total price present', () => pm.expect(res.data.cart).to.have.property('totalPrice'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Cart Item Quantity",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],

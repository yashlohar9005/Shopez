{
  "info": {
    "name": "SHOPEZ API Collection",
    "description": "Complete API test collection for the SHOPEZ e-commerce application.\n\nSetup:\n1. Create an environment with variables: baseUrl, token, adminToken\n2. Set baseUrl to http://localhost:5000/api\n3. Register a user and set the token variable\n4. Register an admin and set the adminToken variable",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "cartItemId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Authentication endpoints",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/register" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"9876543210\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Success is true', () => pm.expect(res.success).to.be.true);",
                  "pm.test('Token is returned', () => pm.expect(res.data.token).to.be.a('string'));",
                  "pm.test('User has correct role', () => pm.expect(res.data.user.role).to.equal('user'));",
                  "pm.test('Password is not returned', () => pm.expect(res.data.user.password).to.be.undefined);",
                  "",
                  "if (res.success) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "  pm.collectionVariables.set('userId', res.data.user._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register User - Duplicate Email (should fail)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/register" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe Again\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('Success is false', () => pm.expect(res.success).to.be.false);",
                  "pm.test('Error message mentions email', () => pm.expect(res.message.toLowerCase()).to.include('email'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register User - Invalid Data (should fail)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/register" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\",\n  \"password\": \"123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Success is false', () => pm.expect(res.success).to.be.false);",
                  "pm.test('Validation errors present', () => pm.expect(res.error.details).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Admin",
